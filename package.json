{
  "name": "kedom-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Kedom RPG: a Foundry VTT game system and its content-authoring toolchain.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/system",
    "packages/forge/web",
    "packages/shared"
  ],
  "scripts": {
    "system:build": "npm run build -w @kedom/system",
    "system:watch": "npm run watch -w @kedom/system",
    "system:link": "tsx tools/link-foundry.ts",
    "packs:build": "tsx tools/pack.ts",
    "packs:extract": "tsx tools/unpack.ts",
    "forge:web": "npm run dev -w @kedom/forge-web",
    "forge:api": "go -C packages/forge/api run ./cmd/forge",
    "forge:types": "cd packages/forge/api && tygo generate",
    "forge:sqlc": "cd packages/forge/api && sqlc generate",
    "forge:dump": "tsx tools/dump-content.ts",
    "forge:export:md": "go -C packages/forge/api run ./cmd/forge export md",
    "lint": "npm run lint:ts && npm run lint:go",
    "lint:ts": "eslint .",
    "lint:go": "cd packages/forge/api && golangci-lint run ./...",
    "lint:fix": "eslint . --fix && gofumpt -w packages/forge/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.4",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
