# Dependencies
node_modules/
.pnpm-store/

# Build output. The system builds to packages/system/dist, which is what
# `pnpm system:link` symlinks into Data/systems/kedom.
dist/
build/
*.tsbuildinfo
packages/forge/api/bin/

# Compiled compendium packs. YAML under packs/_source/ is the committed artefact;
# the LevelDB directories are generated by `pnpm packs:build`.
packages/system/packs/*/
!packages/system/packs/_source/

# Generated code. Regenerate with `pnpm forge:types` / `pnpm forge:sqlc`.
packages/shared/src/generated/
packages/forge/api/internal/repository/generated/

# Local developer config: absolute path to your Foundry user data directory.
foundry-config.json
.env
.env.local

# Forge working state. The authored database and its reviewable dump ARE committed
# (see docs/forge/schema.md); these are transient SQLite sidecars.
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm

# Test output
coverage/
playwright-report/
test-results/
state.json

# Editor and OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
