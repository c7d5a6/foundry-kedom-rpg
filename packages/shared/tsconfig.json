{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    // No DOM and no Foundry globals: this package must stay consumable by both
    // the system and the Forge UI, so it cannot depend on either environment.
    "lib": ["ES2023"],
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
