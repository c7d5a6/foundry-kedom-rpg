{
  "id": "kedom",
  "title": "Kedom RPG",
  "description": "A low-fantasy OSR system in the Worlds Without Number tradition, set in the world of Kedom.",
  "version": "0.0.1",
  "compatibility": {
    "minimum": "14.367",
    "verified": "14"
  },
  "authors": [
    {
      "name": "c7d5a6",
      "github": "c7d5a6"
    }
  ],
  "url": "https://github.com/c7d5a6/foundry-kedom-rpg",
  "manifest": "https://github.com/c7d5a6/foundry-kedom-rpg/releases/latest/download/system.json",
  "download": "https://github.com/c7d5a6/foundry-kedom-rpg/releases/latest/download/kedom.zip",
  "license": "LICENSE",
  "readme": "README.md",
  "bugs": "https://github.com/c7d5a6/foundry-kedom-rpg/issues",

  "esmodules": ["kedom.mjs"],

  "styles": [
    { "src": "css/kedom-tokens.css", "layer": "variables" },
    { "src": "css/kedom-elements.css", "layer": "elements" },
    { "src": "css/kedom-system.css", "layer": "system" }
  ],

  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "ru",
      "name": "Русский",
      "path": "lang/ru.json"
    }
  ],

  "packs": [],
  "packFolders": [],

  "grid": {
    "distance": 5,
    "units": "ft"
  },

  "documentTypes": {
    "Actor": {
      "character": {}
    }
  },

  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["css", "templates", "lang"]
    }
  }
}
