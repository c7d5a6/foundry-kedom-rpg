<div class="kedom-sheet-panels">
  <aside class="kedom-sheet-aside">
    <div class="ability-grid">
      {{#each abilities}}
        <div class="ability">
          <div class="ability__label">{{label}}</div>
          <div class="ability__mod">{{modSigned}}</div>
          {{#if @root.isEdit}}
            <input
              class="ability__score"
              id="ability-{{key}}"
              name="system.abilities.{{key}}.value"
              type="number"
              value="{{value}}"
              min="{{min}}"
              max="{{max}}"
              aria-label="{{label}}"
            />
          {{else}}
            <div class="ability__score">{{value}}</div>
          {{/if}}
        </div>
      {{/each}}
    </div>

    <div class="kedom-aside-rule" aria-hidden="true"></div>

    <div class="kedom-defense" title="{{localize "KEDOM.Attributes.defense"}}">
      <span class="kedom-defense__icon" aria-hidden="true">
        <i class="fa-solid fa-shield-halved" inert></i>
      </span>
      <span class="kedom-defense__label">{{localize "KEDOM.Attributes.defense"}}</span>
      <span class="kedom-defense__value">{{combat.ac}}</span>
    </div>

    <div class="kedom-aside-rule" aria-hidden="true"></div>

    <div class="save-list">
      {{#each saves}}
        {{> "systems/kedom/templates/actor/partials/save.hbs"}}
      {{/each}}
      {{#with luckSave}}
        {{> "systems/kedom/templates/actor/partials/save.hbs"}}
      {{/with}}
    </div>
  </aside>

  <section class="kedom-sheet-main">
    {{#if isSkillsTab}}
      <div class="skill-list">
        {{#each skills}}
          {{> "systems/kedom/templates/actor/partials/skill.hbs"}}
        {{/each}}
      </div>
    {{else if isCombatTab}}
      <div class="kedom-combat-tab">
        <section class="kedom-weapons-panel">
          <header class="kedom-weapons-panel__header">
            <h2 class="kedom-weapons-panel__title">{{localize "KEDOM.Sheet.Weapons"}}</h2>
          </header>
          {{#if weapons.length}}
            <ul class="kedom-weapons-list">
              {{#each weapons}}
                <li class="kedom-weapons-list__item">
                  <div class="kedom-weapons-list__info">
                    <span class="kedom-weapons-list__name">{{name}}</span>
                    <span class="kedom-weapons-list__meta">
                      {{skillLabel}} · {{damageFormula}}
                    </span>
                  </div>
                  <div class="kedom-weapons-list__actions">
                    <button
                      type="button"
                      class="kedom-weapons-list__btn"
                      data-action="rollAttack"
                      data-item-id="{{id}}"
                      {{#unless @root.isPlay}}disabled{{/unless}}
                      title="{{localize "KEDOM.Sheet.Action.rollAttack"}} {{attackTotalSigned}}"
                    >
                      {{localize "KEDOM.Sheet.Action.rollAttack"}}
                      <span class="kedom-roll-bonus">{{attackTotalSigned}}</span>
                    </button>
                    <button
                      type="button"
                      class="kedom-weapons-list__btn"
                      data-action="rollDamage"
                      data-item-id="{{id}}"
                      {{#unless @root.isPlay}}disabled{{/unless}}
                      title="{{localize "KEDOM.Sheet.Action.rollDamage"}} {{damageTotalSigned}}"
                    >
                      {{localize "KEDOM.Sheet.Action.rollDamage"}}
                      <span class="kedom-roll-bonus">{{damageTotalSigned}}</span>
                    </button>
                    {{#if @root.isEdit}}
                      <button
                        type="button"
                        class="kedom-weapons-list__btn kedom-weapons-list__btn--icon"
                        data-action="editWeapon"
                        data-item-id="{{id}}"
                        title="{{localize "KEDOM.Sheet.Action.editWeapon"}}"
                        aria-label="{{localize "KEDOM.Sheet.Action.editWeapon"}}"
                      >
                        <i class="fa-solid fa-pen" inert></i>
                      </button>
                      <button
                        type="button"
                        class="kedom-weapons-list__btn kedom-weapons-list__btn--icon"
                        data-action="deleteWeapon"
                        data-item-id="{{id}}"
                        {{#unless @root.editable}}disabled{{/unless}}
                        title="{{localize "KEDOM.Sheet.Action.deleteWeapon"}}"
                        aria-label="{{localize "KEDOM.Sheet.Action.deleteWeapon"}}"
                      >
                        <i class="fa-solid fa-trash" inert></i>
                      </button>
                    {{/if}}
                  </div>
                </li>
              {{/each}}
            </ul>
          {{else}}
            <p class="kedom-weapons-panel__empty">{{localize "KEDOM.Sheet.WeaponsEmpty"}}</p>
          {{/if}}
        </section>

        <section class="kedom-weapons-panel">
          <header class="kedom-weapons-panel__header">
            <h2 class="kedom-weapons-panel__title">{{localize "KEDOM.Sheet.Armor"}}</h2>
          </header>
          {{#if armor.length}}
            <ul class="kedom-weapons-list">
              {{#each armor}}
                <li class="kedom-weapons-list__item">
                  <div class="kedom-weapons-list__info">
                    <span class="kedom-weapons-list__name">{{name}}</span>
                    <span class="kedom-weapons-list__meta">
                      {{localize "KEDOM.Armor.woundBonus"}}
                      {{#if woundBonusSigned}} {{woundBonusSigned}}{{else}} +0{{/if}}
                    </span>
                  </div>
                  {{#if @root.isEdit}}
                    <div class="kedom-weapons-list__actions">
                      <button
                        type="button"
                        class="kedom-weapons-list__btn kedom-weapons-list__btn--icon"
                        data-action="editArmor"
                        data-item-id="{{id}}"
                        title="{{localize "KEDOM.Sheet.Action.editArmor"}}"
                        aria-label="{{localize "KEDOM.Sheet.Action.editArmor"}}"
                      >
                        <i class="fa-solid fa-pen" inert></i>
                      </button>
                      <button
                        type="button"
                        class="kedom-weapons-list__btn kedom-weapons-list__btn--icon"
                        data-action="deleteArmor"
                        data-item-id="{{id}}"
                        {{#unless @root.editable}}disabled{{/unless}}
                        title="{{localize "KEDOM.Sheet.Action.deleteArmor"}}"
                        aria-label="{{localize "KEDOM.Sheet.Action.deleteArmor"}}"
                      >
                        <i class="fa-solid fa-trash" inert></i>
                      </button>
                    </div>
                  {{/if}}
                </li>
              {{/each}}
            </ul>
          {{else}}
            <p class="kedom-weapons-panel__empty">{{localize "KEDOM.Sheet.ArmorEmpty"}}</p>
          {{/if}}
        </section>

        <section class="kedom-wounds-panel">
          <header class="kedom-wounds-panel__header">
            <h2 class="kedom-wounds-panel__title">{{localize "KEDOM.Attributes.wounds"}}</h2>
            {{#if resources.wounded}}
              <span class="kedom-wounds-panel__badge">{{localize "KEDOM.Condition.wounded"}}</span>
            {{/if}}
          </header>

          <div class="kedom-wounds-panel__controls">
            <div
              class="kedom-meter kedom-meter--wounds"
              data-resource="wounds"
              data-action="editResource"
              title="{{localize "KEDOM.Attributes.wounds"}}"
            >
              <div class="kedom-meter__content">
                <span class="kedom-meter__name">{{localize "KEDOM.Attributes.wounds"}}</span>
                <span class="kedom-meter__value">{{resources.wounds.value}}</span>
                <input
                  class="kedom-meter__edit-value"
                  type="number"
                  name="system.attributes.wounds.value"
                  value="{{resources.wounds.value}}"
                  min="0"
                  aria-label="{{localize "KEDOM.Attributes.wounds"}}"
                />
              </div>
            </div>

            <button
              type="button"
              class="kedom-wounds-panel__take"
              data-action="takeWound"
              {{#unless @root.isPlay}}disabled{{/unless}}
              title="{{localize "KEDOM.Sheet.Action.takeWound"}} {{combat.woundLuckSigned}}"
            >
              {{localize "KEDOM.Sheet.Action.takeWound"}}
              <span class="kedom-roll-bonus">{{combat.woundLuckSigned}}</span>
            </button>
          </div>

          <div class="kedom-wounds-panel__notes">
            <label class="kedom-wounds-panel__notes-label">{{localize "KEDOM.Sheet.WoundNotes"}}</label>
            {{#if editable}}
              {{formInput
                systemFields.attributes.fields.wounds.fields.notes
                value=source.system.attributes.wounds.notes
                enriched=enrichedWoundsNotes
                toggled=true
              }}
            {{else}}
              <div class="kedom-wounds-panel__notes-view">{{{enrichedWoundsNotes}}}</div>
            {{/if}}
          </div>
        </section>
      </div>
    {{else if isTalentsTab}}
      <section class="kedom-talents-panel">
        <header class="kedom-talents-panel__header">
          <h2 class="kedom-talents-panel__title">{{localize "KEDOM.Sheet.Talents"}}</h2>
          {{#if isEdit}}
            <button
              type="button"
              class="kedom-talents-panel__create"
              data-action="createTalent"
              title="{{localize "KEDOM.Sheet.Action.createTalent"}}"
            >
              {{localize "KEDOM.Sheet.Action.createTalent"}}
            </button>
          {{/if}}
        </header>
        {{#if talents.length}}
          <ul class="kedom-talents-list">
            {{#each talents}}
              <li class="kedom-talents-list__item">
                <details class="kedom-talents-list__details">
                  <summary class="kedom-talents-list__summary">
                    <img class="kedom-talents-list__img" src="{{img}}" alt="" />
                    <span class="kedom-talents-list__name">{{name}}</span>
                    <i class="fa-solid fa-chevron-down kedom-talents-list__chevron" inert></i>
                  </summary>
                  <div class="kedom-talents-list__body">
                    {{#if hasDescription}}
                      <div class="kedom-talents-list__description">{{{enrichedDescription}}}</div>
                    {{else}}
                      <p class="kedom-talents-list__description-empty">{{localize "KEDOM.Sheet.TalentNoDescription"}}</p>
                    {{/if}}
                  </div>
                </details>
                {{#if @root.isEdit}}
                  <div class="kedom-talents-list__actions">
                    <button
                      type="button"
                      class="kedom-talents-list__btn"
                      data-action="editTalent"
                      data-item-id="{{id}}"
                      title="{{localize "KEDOM.Sheet.Action.edit"}}"
                      aria-label="{{localize "KEDOM.Sheet.Action.edit"}}"
                    >
                      <i class="fa-solid fa-pen" inert></i>
                    </button>
                    <button
                      type="button"
                      class="kedom-talents-list__btn"
                      data-action="deleteTalent"
                      data-item-id="{{id}}"
                      {{#unless @root.editable}}disabled{{/unless}}
                      title="{{localize "KEDOM.Sheet.Action.deleteOwnedItem"}}"
                      aria-label="{{localize "KEDOM.Sheet.Action.deleteOwnedItem"}}"
                    >
                      <i class="fa-solid fa-trash" inert></i>
                    </button>
                  </div>
                {{/if}}
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p class="kedom-talents-panel__empty">{{localize "KEDOM.Sheet.TalentsEmpty"}}</p>
        {{/if}}
      </section>
    {{else if isArtsTab}}
      <section class="kedom-arts-panel">
        <header class="kedom-arts-panel__header">
          <h2 class="kedom-arts-panel__title">{{localize "KEDOM.Sheet.Arts"}}</h2>
          <div class="kedom-arts-panel__stats">
            <span>{{localize "KEDOM.Art.Effort"}} {{effort.value}} / {{effort.max}}</span>
            <span>{{localize "KEDOM.Sheet.Arts"}} {{effort.artsOwned}} / {{effort.artsBudget}}</span>
          </div>
          {{#if isArtOwner}}
            <div class="kedom-arts-panel__owner-actions">
              <button type="button" class="kedom-arts-panel__btn" data-action="endArtScene">
                {{localize "KEDOM.Art.EndScene"}}
              </button>
              <button type="button" class="kedom-arts-panel__btn" data-action="endArtDay">
                {{localize "KEDOM.Art.EndDay"}}
              </button>
            </div>
          {{/if}}
        </header>

        {{#if arts.length}}
          <ul class="kedom-arts-list">
            {{#each arts}}
              <li class="kedom-arts-list__item{{#if holding}} is-committed{{/if}}">
                <details class="kedom-arts-list__details">
                  <summary class="kedom-arts-list__summary">
                    <img class="kedom-arts-list__img" src="{{img}}" alt="" />
                    <span class="kedom-arts-list__name">{{name}}</span>
                    <span class="kedom-arts-list__meta">{{commitmentLabel}}</span>
                    <i class="fa-solid fa-chevron-down kedom-arts-list__chevron" inert></i>
                  </summary>
                  <div class="kedom-arts-list__body">
                    {{#if hasDescription}}
                      <div class="kedom-arts-list__description">{{{enrichedDescription}}}</div>
                    {{else}}
                      <p class="kedom-arts-list__description-empty">{{localize "KEDOM.Sheet.ArtNoDescription"}}</p>
                    {{/if}}
                  </div>
                </details>
                <div class="kedom-arts-list__actions">
                  {{#if isConcentration}}
                    <button
                      type="button"
                      class="kedom-arts-list__btn"
                      data-action="toggleArtConcentration"
                      data-item-id="{{id}}"
                      {{#unless @root.editable}}disabled{{/unless}}
                    >
                      {{localize "KEDOM.Art.Concentrate"}}
                    </button>
                  {{else}}
                    <button
                      type="button"
                      class="kedom-arts-list__btn"
                      data-action="useArt"
                      data-item-id="{{id}}"
                      {{#unless @root.editable}}disabled{{/unless}}
                    >
                      {{localize "KEDOM.Art.Use"}}
                    </button>
                  {{/if}}
                  {{#if @root.isEdit}}
                    <button
                      type="button"
                      class="kedom-arts-list__btn"
                      data-action="editArt"
                      data-item-id="{{id}}"
                      title="{{localize "KEDOM.Sheet.Action.edit"}}"
                    >
                      <i class="fa-solid fa-pen" inert></i>
                    </button>
                    <button
                      type="button"
                      class="kedom-arts-list__btn"
                      data-action="deleteArt"
                      data-item-id="{{id}}"
                      {{#unless @root.editable}}disabled{{/unless}}
                      title="{{localize "KEDOM.Sheet.Action.deleteOwnedItem"}}"
                    >
                      <i class="fa-solid fa-trash" inert></i>
                    </button>
                  {{/if}}
                </div>
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p class="kedom-arts-panel__empty">{{localize "KEDOM.Sheet.ArtsEmpty"}}</p>
        {{/if}}

        <div class="kedom-arts-used">
          <h3 class="kedom-arts-used__title">{{localize "KEDOM.Art.Used"}}</h3>
          <div class="kedom-arts-used__group">
            <h4>{{localize "KEDOM.Art.Commitment.concentration"}}</h4>
            {{#if usedConcentration.length}}
              <ul>
                {{#each usedConcentration}}
                  <li class="kedom-arts-used__row">
                    <span>{{name}}</span>
                    <button
                      type="button"
                      class="kedom-arts-used__release"
                      data-action="releaseArtEffort"
                      data-item-id="{{id}}"
                      {{#unless @root.editable}}disabled{{/unless}}
                      title="{{localize "KEDOM.Art.Release"}}"
                    >
                      <i class="fa-solid fa-xmark" inert></i>
                    </button>
                  </li>
                {{/each}}
              </ul>
            {{else}}
              <p class="kedom-arts-used__empty">—</p>
            {{/if}}
          </div>
          <div class="kedom-arts-used__group">
            <h4>{{localize "KEDOM.Art.Commitment.scene"}}</h4>
            {{#if usedScene.length}}
              <ul>
                {{#each usedScene}}
                  <li class="kedom-arts-used__row">
                    <span>{{name}}</span>
                    <button
                      type="button"
                      class="kedom-arts-used__release"
                      data-action="releaseArtEffort"
                      data-item-id="{{id}}"
                      {{#unless @root.editable}}disabled{{/unless}}
                      title="{{localize "KEDOM.Art.Release"}}"
                    >
                      <i class="fa-solid fa-xmark" inert></i>
                    </button>
                  </li>
                {{/each}}
              </ul>
            {{else}}
              <p class="kedom-arts-used__empty">—</p>
            {{/if}}
          </div>
          <div class="kedom-arts-used__group">
            <h4>{{localize "KEDOM.Art.Commitment.day"}}</h4>
            {{#if usedDay.length}}
              <ul>
                {{#each usedDay}}
                  <li class="kedom-arts-used__row">
                    <span>{{name}}</span>
                    <button
                      type="button"
                      class="kedom-arts-used__release"
                      data-action="releaseArtEffort"
                      data-item-id="{{id}}"
                      {{#unless @root.editable}}disabled{{/unless}}
                      title="{{localize "KEDOM.Art.Release"}}"
                    >
                      <i class="fa-solid fa-xmark" inert></i>
                    </button>
                  </li>
                {{/each}}
              </ul>
            {{else}}
              <p class="kedom-arts-used__empty">—</p>
            {{/if}}
          </div>
        </div>
      </section>
    {{else if isNotesTab}}
      <section class="kedom-notes-panel">
        {{#if editable}}
          {{formInput
            systemFields.details.fields.notes
            value=source.system.details.notes
            enriched=enrichedNotes
            toggled=true
          }}
        {{else}}
          <div class="kedom-notes-panel__view">{{{enrichedNotes}}}</div>
        {{/if}}
      </section>
    {{else if isEffectsTab}}
      <div class="kedom-effects-tab">
        <section class="kedom-effects-panel">
          <header class="kedom-effects-panel__header">
            <h2 class="kedom-effects-panel__title">{{localize "KEDOM.Sheet.EffectsOnCharacter"}}</h2>
            {{#if isEdit}}
              <button
                type="button"
                class="kedom-effects-panel__btn"
                data-action="createActorEffect"
                title="{{localize "KEDOM.Sheet.Action.createEffect"}}"
              >
                {{localize "KEDOM.Sheet.Action.createEffect"}}
              </button>
            {{/if}}
          </header>
          {{#if actorEffects.length}}
            <ul class="kedom-effects-list">
              {{#each actorEffects}}
                <li class="kedom-effects-list__item{{#if disabled}} is-disabled{{/if}}">
                  <img class="kedom-effects-list__img" src="{{img}}" alt="" />
                  <div class="kedom-effects-list__info">
                    <span class="kedom-effects-list__name">{{name}}</span>
                    {{#if disabled}}
                      <span class="kedom-effects-list__meta">{{localize "KEDOM.Sheet.EffectDisabled"}}</span>
                    {{/if}}
                  </div>
                  {{#if @root.isEdit}}
                    <div class="kedom-effects-list__actions">
                      <button
                        type="button"
                        class="kedom-effects-list__btn"
                        data-action="toggleEffect"
                        data-effect-id="{{id}}"
                        {{#unless @root.editable}}disabled{{/unless}}
                        title="{{localize "KEDOM.Sheet.Action.toggleEffect"}}"
                      >
                        <i class="fa-solid {{#if disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}" inert></i>
                      </button>
                      <button
                        type="button"
                        class="kedom-effects-list__btn"
                        data-action="editEffect"
                        data-effect-id="{{id}}"
                        title="{{localize "KEDOM.Sheet.Action.editEffect"}}"
                      >
                        <i class="fa-solid fa-pen" inert></i>
                      </button>
                      <button
                        type="button"
                        class="kedom-effects-list__btn"
                        data-action="deleteEffect"
                        data-effect-id="{{id}}"
                        {{#unless @root.editable}}disabled{{/unless}}
                        title="{{localize "KEDOM.Sheet.Action.deleteEffect"}}"
                      >
                        <i class="fa-solid fa-trash" inert></i>
                      </button>
                    </div>
                  {{/if}}
                </li>
              {{/each}}
            </ul>
          {{else}}
            <p class="kedom-effects-panel__empty">{{localize "KEDOM.Sheet.EffectsOnCharacterEmpty"}}</p>
          {{/if}}
        </section>

        <section class="kedom-effects-panel">
          <header class="kedom-effects-panel__header">
            <h2 class="kedom-effects-panel__title">{{localize "KEDOM.Sheet.EffectsFromItems"}}</h2>
          </header>
          {{#if itemEffects.length}}
            <ul class="kedom-effects-list">
              {{#each itemEffects}}
                <li class="kedom-effects-list__item{{#if disabled}} is-disabled{{/if}}">
                  <img class="kedom-effects-list__img" src="{{img}}" alt="" />
                  <div class="kedom-effects-list__info">
                    <span class="kedom-effects-list__name">{{name}}</span>
                    <span class="kedom-effects-list__meta">
                      {{#if sourceName}}{{sourceName}}{{/if}}
                      {{#if disabled}} · {{localize "KEDOM.Sheet.EffectDisabled"}}{{/if}}
                    </span>
                  </div>
                  {{#if @root.isEdit}}
                    <div class="kedom-effects-list__actions">
                      <button
                        type="button"
                        class="kedom-effects-list__btn"
                        data-action="toggleEffect"
                        data-effect-id="{{id}}"
                        {{#unless @root.editable}}disabled{{/unless}}
                        title="{{localize "KEDOM.Sheet.Action.toggleEffect"}}"
                      >
                        <i class="fa-solid {{#if disabled}}fa-toggle-off{{else}}fa-toggle-on{{/if}}" inert></i>
                      </button>
                      {{#if parentItemId}}
                        <button
                          type="button"
                          class="kedom-effects-list__btn"
                          data-action="openEffectSource"
                          data-item-id="{{parentItemId}}"
                          title="{{localize "KEDOM.Sheet.Action.openEffectSource"}}"
                        >
                          <i class="fa-solid fa-box" inert></i>
                        </button>
                      {{/if}}
                      <button
                        type="button"
                        class="kedom-effects-list__btn"
                        data-action="editEffect"
                        data-effect-id="{{id}}"
                        title="{{localize "KEDOM.Sheet.Action.editEffect"}}"
                      >
                        <i class="fa-solid fa-pen" inert></i>
                      </button>
                    </div>
                  {{/if}}
                </li>
              {{/each}}
            </ul>
          {{else}}
            <p class="kedom-effects-panel__empty">{{localize "KEDOM.Sheet.EffectsFromItemsEmpty"}}</p>
          {{/if}}
        </section>
      </div>
    {{/if}}
  </section>
</div>
