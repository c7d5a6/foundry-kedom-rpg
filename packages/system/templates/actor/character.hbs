<div class="kedom-sheet-body">
  <header class="sheet-header">
    <img
      class="profile-img"
      src="{{actor.img}}"
      alt="{{actor.name}}"
      data-action="editImage"
      data-edit="img"
      title="{{localize "KEDOM.Sheet.EditPortrait"}}"
    />
    <h1>
      {{formInput fields.name value=source.name placeholder=(localize "DOCUMENT.FIELDS.name.label")}}
    </h1>
  </header>

  <section class="abilities">
    <h2>{{localize "KEDOM.Sheet.Abilities"}}</h2>
    <div class="ability-grid">
      {{#each abilities}}
        <div class="ability">
          <label for="ability-{{key}}">{{label}} ({{abbr}})</label>
          <input
            id="ability-{{key}}"
            name="system.abilities.{{key}}.value"
            type="number"
            value="{{value}}"
            min="3"
            max="18"
          />
          <span class="mod">{{localize "KEDOM.Sheet.Mod"}} {{modSigned}}</span>
        </div>
      {{/each}}
    </div>
  </section>

  <section class="skills">
    <h2>{{localize "KEDOM.Sheet.Skills"}}</h2>
    <div class="skill-list">
      {{#each skills}}
        <div class="kedom-skill {{proficiencyClass}}">
          <div class="kedom-skill__row">
            <button
              type="button"
              class="kedom-skill__name"
              data-action="rollSkill"
              data-skill-key="{{key}}"
            >
              <span class="kedom-skill__label">
                {{label}}
                <small>({{abilityAbbr}})</small>
              </span>
              <span class="kedom-skill__bonus">{{bonusSigned}}</span>
            </button>
            <select name="system.skills.{{key}}.proficiency">
              {{#each proficiencyOptions}}
                {{#if selected}}
                  <option value="{{value}}" selected>{{label}}</option>
                {{else}}
                  <option value="{{value}}">{{label}}</option>
                {{/if}}
              {{/each}}
            </select>
          </div>

          {{#if allowsSpecialization}}
            <ul class="kedom-skill__specs">
              {{#each specializations}}
                <li class="kedom-skill__spec">
                  <button
                    type="button"
                    class="kedom-skill__spec-name"
                    data-action="rollSpecialization"
                    data-skill-key="{{skillKey}}"
                    data-specialization-slug="{{slug}}"
                  >
                    <span class="kedom-skill__label">{{label}}</span>
                    <span class="kedom-skill__bonus">{{bonusSigned}}</span>
                  </button>
                  <button
                    type="button"
                    class="kedom-skill__spec-remove"
                    data-action="removeSpecialization"
                    data-skill-key="{{skillKey}}"
                    data-specialization-slug="{{slug}}"
                    title="{{localize 'KEDOM.Sheet.Action.delete'}}"
                  >
                    ×
                  </button>
                </li>
              {{/each}}
            </ul>

            {{#if isFree}}
              <button
                type="button"
                class="kedom-skill__add"
                data-action="addSpecialization"
                data-skill-key="{{key}}"
              >
                {{localize "KEDOM.Sheet.Action.addSpecializationShort"}}
              </button>
            {{/if}}

            {{#if isFixed}}
              {{#if availableFixed.length}}
                <div class="kedom-skill__fixed-add">
                  <select class="kedom-skill__fixed-select" data-skill-key="{{key}}">
                    {{#each availableFixed}}
                      <option value="{{leaf}}">{{label}}</option>
                    {{/each}}
                  </select>
                  <button
                    type="button"
                    class="kedom-skill__add"
                    data-action="addSpecialization"
                    data-skill-key="{{key}}"
                  >
                    +
                  </button>
                </div>
              {{/if}}
            {{/if}}
          {{/if}}
        </div>
      {{/each}}
    </div>
  </section>
</div>